# Local dev (default): a Postgres role/db created by `pg_ctlcluster` locally.
# Swap for a Supabase connection string when the project exists — the
# pooled ("Transaction", port 6543) string for the app, the direct (5432)
# one for `npm run db:push` / migrations.
DATABASE_URL="postgresql://dealdesk:dealdesk@localhost:5432/dealdesk_sourcing"

# console.anthropic.com → Settings → API Keys. Required for document
# extraction (TurboPass, bank statements, credit reports, credit apps).
ANTHROPIC_API_KEY=""
