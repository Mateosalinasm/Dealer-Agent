# Local dev fallback: a Postgres role/db created by `pg_ctlcluster` locally.
# For Supabase, use the pooler host for BOTH — the app runs on the
# transaction-mode pooler (port 6543), migrations need the session-mode
# pooler (port 5432, same host) since it supports prepared statements and
# doesn't require the paid IPv4 add-on the raw direct connection does.
DATABASE_URL="postgresql://dealdesk:dealdesk@localhost:5432/dealdesk_sourcing"
DIRECT_URL="postgresql://dealdesk:dealdesk@localhost:5432/dealdesk_sourcing"

# console.anthropic.com → Settings → API Keys. Required for document
# extraction (TurboPass, bank statements, credit reports, credit apps).
ANTHROPIC_API_KEY=""
